# Copy to .env and fill in as needed.
#
# Nothing in this project requires ANY of these to run. Data preparation
# (Phase 1), intent classification (Phase 2), and retrieval (Phase 3) don't
# read any of them at all. The agent (Phase 4) explicitly runs on a
# deterministic mock LLM provider when none of the LLM_PROVIDER/
# OPENAI_API_KEY variables below are set — see src/agent/llm.py.

# --- Optional path overrides (normally set in configs/config.yaml instead) -
# CONFIG_PATH=configs/config.yaml
# RAW_CSV_PATH=data/raw/twcs.csv
# PROCESSED_DIR=data/processed
# SPLITS_DIR=data/splits
# SPLIT_SEED=42

# --- Optional config path overrides for the agent --------------------------
# INTENTS_CONFIG_PATH=configs/intents.yaml
# ESCALATION_CONFIG_PATH=configs/escalation.yaml

# --- LLM provider (Phase 4 agent) -------------------------------------------
# LLM_PROVIDER=mock              # "mock" (default if no key set) or "openai"
# OPENAI_API_KEY=                # required only if LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-mini       # optional, defaults to gpt-4o-mini

# --- Not currently used by anything in this repo ----------------------------
# ANTHROPIC_API_KEY=
